# ─────────────────────────────────────────────────────────────────────────────
# DabaCash — variables d'environnement. Copier vers .env (jamais commité).
# Aucune valeur ci-dessous n'est un secret réel. Voir docs/ENVIRONMENT.md.
# ─────────────────────────────────────────────────────────────────────────────

# ── Base de données (obligatoire) ────────────────────────────────────────────
DATABASE_URL="postgresql://dabacash:CHANGE_ME_DB@localhost:5432/dabacash"
DIRECT_URL="postgresql://dabacash:CHANGE_ME_DB@localhost:5432/dabacash"

# ── Authentification (obligatoire, ≥ 32 caractères, DIFFÉRENTS l'un de l'autre)
# Générer : openssl rand -base64 48
JWT_SECRET=""
JWT_REFRESH_SECRET=""
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"
BCRYPT_ROUNDS=12            # ≥ 10 en production

# ── API ──────────────────────────────────────────────────────────────────────
API_PORT=4000
NODE_ENV=development        # "production" active les contrôles stricts au démarrage
# Origines web autorisées (CORS), séparées par des virgules. OBLIGATOIRE en production, pas de "*".
CORS_ORIGINS="http://localhost:3000"
# Derrière un reverse proxy / load balancer : nombre de sauts de confiance (ex. 1) pour obtenir la vraie IP client.
TRUST_PROXY=""
# Swagger (/docs) : actif hors production ; en production seulement si "true".
ENABLE_SWAGGER=""
THROTTLE_LIMIT=120          # requêtes / minute / IP (global)
# JAMAIS en production (refusé au démarrage). Réservé aux tests d'intégration.
THROTTLE_DISABLED=""
APP_VERSION=""              # affiché par GET /api/v1/health

# ── Web ──────────────────────────────────────────────────────────────────────
# URL publique de l'API vue par le navigateur (compilée dans le bundle web)
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="http://localhost:4000"
# URL publique HTTPS du site (Aslan exige des URLs de retour https en production)
WEB_URL="http://localhost:3000"

# ── Paiement Aslan (aslan.ma) ────────────────────────────────────────────────
# sk_test_* = bac à sable. sk_live_* = argent réel : jamais en développement.
ASLAN_SECRET_KEY=""
ASLAN_WEBHOOK_SECRET=""     # obligatoire si clé sk_live_*. Vérifie X-Webhook-Signature (HMAC)
ASLAN_API_URL="https://api.aslanpay.ma/pay/api/v1"
# Webhook à déclarer chez Aslan : https://<hôte-api>/api/v1/payments/aslan/webhook

# ── Emails transactionnels (Resend) — facultatif, "au mieux" ─────────────────
EMAIL_FROM="noreply@dabacash.ma"
RESEND_API_KEY=""
# RESEND_API_URL=""         # surcharge (tests)

# ── Scripts de base de données (ne jamais les renseigner dans un fichier commité) ─
# Compte administrateur initial : npm run db:create-admin --workspace=packages/database
# ADMIN_EMAIL=""
# ADMIN_PASSWORD=""         # ≥ 10 caractères, lettre + chiffre
# Données de démonstration (refusées en production sauf ALLOW_DEMO_SEED=true) :
# DEMO_PASSWORD=""          # sinon un mot de passe aléatoire est généré et affiché une fois
# ALLOW_DEMO_SEED=""
