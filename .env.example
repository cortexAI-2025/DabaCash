# Database
DATABASE_URL="postgresql://postgres:password@localhost:5432/dabacash"
DIRECT_URL="postgresql://postgres:password@localhost:5432/dabacash"

# JWT Auth
JWT_SECRET="your-super-secret-jwt-key-min-32-chars"
JWT_REFRESH_SECRET="your-super-secret-refresh-key"
JWT_EXPIRES_IN="15m"
JWT_REFRESH_EXPIRES_IN="7d"

# Redis (optional caching)
REDIS_URL="redis://localhost:6379"

# API
API_PORT=4000
API_URL="http://localhost:4000"

# Web
NEXT_PUBLIC_API_URL="http://localhost:4000"
NEXT_PUBLIC_WS_URL="ws://localhost:4000"

# Google Maps
NEXT_PUBLIC_GOOGLE_MAPS_API_KEY=""

# Aslan (aslan.ma) — online payments: hosted checkout, card + cash-to-web
# Keys: Aslan dashboard. sk_test_* = sandbox, sk_live_* = real money. Server-side only.
ASLAN_SECRET_KEY=""
# Secret used to verify X-Webhook-Signature. Webhook URL to register in Aslan:
#   https://<your-api-host>/api/v1/payments/aslan/webhook
ASLAN_WEBHOOK_SECRET=""
ASLAN_API_URL="https://api.aslanpay.ma/pay/api/v1"
# Public HTTPS URL of the web app (Aslan requires https success/cancel URLs)
WEB_URL="https://dabacash.ma"

# Stripe (fallback payment)
STRIPE_SECRET_KEY=""
STRIPE_PUBLISHABLE_KEY=""
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=""

# Email (Resend or SendGrid)
EMAIL_FROM="noreply@dabacash.ma"
RESEND_API_KEY=""

# WhatsApp (optional)
WHATSAPP_TOKEN=""
WHATSAPP_PHONE_ID=""
